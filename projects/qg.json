  "confluence": null,
  "repos": {
    "app": {
      "id": "github:quokkapps/quokkaguide-kmp",
      "defaultBranch": "main",
      "kind": "kmp-mobile",
      "gitignoredFiles": [
        "android/app/src/staging/google-services.json",
        "android/app/src/production/google-services.json",
        "android/app/src/staging/assets/",
        "android/app/src/production/assets/",
        "android/app/appcdm_debug.jks",
        "ios/Quokka/Supporting Files/GoogleServices/Staging/GoogleService-Info.plist",
        "ios/Quokka/Supporting Files/GoogleServices/Prod/GoogleService-Info.plist"
      ],
      "gates": {
        "targeted": "cd android && ./gradlew --no-watch-fs <module>:testDebugUnitTest --tests <Test>",
        "module": "cd android && ./gradlew --no-watch-fs <module>:testDebugUnitTest spotlessCheck",
        "full": "cd android && ./gradlew --no-watch-fs spotlessCheck testDebugUnitTest :app:assembleStagingDebug :shared:sdk:assembleQuokkaSharedDebugXCFramework && cd ../ios && xcodebuild -workspace Quokka.xcworkspace -scheme QuokkaSTG build",
        "iosTest": "xcodebuild test -workspace ios/Quokka.xcworkspace -scheme QuokkaSTG -destination 'id=<simUdid>' -parallel-testing-enabled NO -test-timeouts-enabled YES -default-test-execution-time-allowance 120 -maximum-test-execution-time-allowance 300"
      },
      "env": { "JAVA_HOME": "<local jdk17>" },
      "screenshotTests": "Roborazzi (baselines stay committed)",
      "staging": {
        "androidPackage": "com.vata.quokkaguide.staging",
        "launch": "adb -s <emulator> shell monkey -p com.vata.quokkaguide.staging -c android.intent.category.LAUNCHER 1"
      }
    },
    "web": {
      "id": "github:quokkapps/quokkaguideweb",
      "defaultBranch": "main",
      "kind": "web-monorepo",
      "gates": {
        "targeted": "read the repo's package.json / AGENTS.md for the per-app test command",
        "module": "read the repo's package.json / AGENTS.md",
        "full": "read the repo's package.json / AGENTS.md"
      },
      "screenshotTests": "browser screenshots of changed pages at 390px and 1440px"
    }
  },
  "deviceRules": [
    "Android: install and test ONLY on the configured emulator with `adb -s <emulator> install -r <apk>`. NEVER run Gradle install* or connected* tasks: they reach every connected device, including physical phones and watches.",
    "iOS: simulator only. Drive the app through XCUITest (idb taps are dropped on this Xcode).",
    "Never buy anything, reset a password, or delete the test account."
  ],
  "testAccount": "Ask Tam for the QG staging test login. Never commit it.",
  "screenshots": { "commit": false }
}
